@[expose] public noncomputable section

open MeasureTheory
open scoped BigOperators

namespace KAM.Planetary

/-- The family H0 + mu P in CP10 (1); no auxiliary normal form is substituted. -/
def degenerateHamiltonian {a b : ℕ} (H0 : (Fin a → ℝ) → ℝ)
    (P : ℝ → Phase (a + b) → ℝ) (mu : ℝ) (z : Phase (a + b)) : ℝ :=
  H0 (fast z.2) + mu * P mu z

end KAM.Planetary

